  },
  "license": "MIT",
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vite": "8.3.4"
  }
}
