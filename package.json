{
  "name": "claude-task",
  "version": "0.1.0",
  "description": "一键给项目装上 Claude Code 任务记录 + 记忆工作流（CLAUDE.md、docs/tasks、memory、hooks）",
  "type": "module",
  "bin": {
    "claude-task": "bin/claude-task.mjs"
  },
  "files": [
